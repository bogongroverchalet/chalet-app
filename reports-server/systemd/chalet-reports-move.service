[Unit]
Description=Move app-submitted NOBs reports from the Dropbox app folder into the File requests reports folder

[Service]
Type=oneshot
# Server-side move with the full-access remote; the web container only has the app-folder token.
# Testing-week uploads stay in the app folder so they never reach the real reports folder.
ExecStart=/usr/bin/rclone move "dropbox:Apps/Bogong Nobs Reports" "dropbox:File requests/Bogong Rover Chalet Nobs reports" --exclude "/*/Testing/**" --delete-empty-src-dirs -v
